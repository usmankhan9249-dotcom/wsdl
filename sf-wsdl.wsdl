<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="urn:partner.soap.sforce.com"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             name="SalesforceLeadCreate"
             targetNamespace="urn:partner.soap.sforce.com">

  <types>
    <xsd:schema targetNamespace="urn:partner.soap.sforce.com">

      <!-- Create operation wrapper element -->
      <xsd:element name="sObjects">
        <xsd:complexType>
          <xsd:sequence>
             <!-- All Lead fields are defined inline here, breaking Salesforce API conventions -->
              <xsd:element name="type" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Company" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Email" type="xsd:string" minOccurs="0"/>
              <xsd:element name="PostalCode" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Acquiring_Page__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Lead_Type_c__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Industry" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Phone" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Street" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Type_of_Business__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Referral_ID__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="City" type="xsd:string" minOccurs="0"/>
              <xsd:element name="OwnerID" type="xsd:string" minOccurs="0"/>
              <xsd:element name="LeadSource" type="xsd:string" minOccurs="0"/>
              <xsd:element name="State" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Comments__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="RecordTypeID" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Country" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Referral_URL__c" type="xsd:string" minOccurs="0"/>
              <xsd:element name="LastName" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
      </xsd:complexType>
      </xsd:element>

      <!-- Response wrapper element -->
      <xsd:element name="createResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="result" type="tns:SaveResult"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- SaveResult type to handle success or errors, including duplicates -->
      <xsd:complexType name="SaveResult">
        <xsd:sequence>
          <xsd:element name="errors" type="tns:Error" minOccurs="0"/>
          <xsd:element name="id" type="xsd:string" nillable="true"/>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence>
      </xsd:complexType>
      
      <!-- General Error type from Salesforce partner WSDL -->
      <xsd:complexType name="Error">
          <xsd:sequence>
              <xsd:element name="fields" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
              <xsd:element name="message" type="xsd:string"/>
              <xsd:element name="statusCode" type="xsd:string"/>
              <xsd:element name="duplicateResult" type="tns:DuplicateResult" minOccurs="0"/>
          </xsd:sequence>
      </xsd:complexType>

      <!-- DuplicateResult type for duplicate detection -->
      <xsd:complexType name="DuplicateResult">
          <xsd:sequence>
              <xsd:element name="allowSave" type="xsd:boolean"/>
              <xsd:element name="duplicateRule" type="xsd:string"/>
              <xsd:element name="duplicateRuleEntityType" type="xsd:string"/>
              <xsd:element name="errorMessage" type="xsd:string"/>
              <xsd:element name="matchResults" type="tns:MatchResult" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
      </xsd:complexType>

      <!-- MatchResult type for detailed duplicate matching results -->
      <xsd:complexType name="MatchResult">
          <xsd:sequence>
              
              <xsd:element name="matchEngine" type="xsd:string"/>
              <xsd:element name="matchRecords" type="tns:MatchRecord" minOccurs="0" maxOccurs="unbounded"/>
              <xsd:element name="rule" type="xsd:string"/>
              <xsd:element name="size" type="xsd:int"/>
              <xsd:element name="success" type="xsd:boolean"/>
          </xsd:sequence>
      </xsd:complexType>

      <!-- MatchRecord type for individual matching records -->
      <xsd:complexType name="MatchRecord">
          <xsd:sequence>
              <xsd:element name="matchConfidence" type="xsd:double"/>
              <xsd:element name="record" type="tns:sObject"/>
          </xsd:sequence>
      </xsd:complexType>

      <!-- Salesforce sObject type for record references -->
      <xsd:complexType name="sObject">
          <xsd:sequence>
              <xsd:element name="type" type="xsd:string"/>
              <xsd:element name="Id" type="xsd:string"/>
          </xsd:sequence>
      </xsd:complexType>
      
      <!-- Lead Type with 'type' removed (remains unchanged from previous refinement) -->
      <xsd:complexType name="Lead">
        <xsd:sequence>
          <xsd:element name="type" type="xsd:string"/>
          <xsd:element name="Company" type="xsd:string"/>
          <xsd:element name="Email" type="xsd:string"/>
          <xsd:element name="PostalCode" type="xsd:string"/>
          <xsd:element name="Acquiring_Page__c" type="xsd:string"/>
          <xsd:element name="Lead_Type_c__c" type="xsd:string"/>
          <xsd:element name="Industry" type="xsd:string"/>
          <xsd:element name="Phone" type="xsd:string"/>
          <xsd:element name="Street" type="xsd:string"/>
          <xsd:element name="Type_of_Business__c" type="xsd:string"/>
          <xsd:element name="Referral_ID__c" type="xsd:string"/>
          <xsd:element name="City" type="xsd:string"/>
          <xsd:element name="OwnerID" type="xsd:string"/>
          <xsd:element name="LeadSource" type="xsd:string"/>
          <xsd:element name="State" type="xsd:string"/>
          <xsd:element name="Comments__c" type="xsd:string"/>
          <xsd:element name="RecordTypeID" type="xsd:string"/>
          <xsd:element name="Country" type="xsd:string"/>
          <xsd:element name="Referral_URL__c" type="xsd:string"/>
          <xsd:element name="LastName" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
  </types>

  <!-- Messages -->
  <message name="CreateLeadRequestMessage">
    <part name="parameters" element="tns:sObjects"/>
  </message>

  <message name="CreateLeadResponseMessage">
    <part name="parameters" element="tns:createResponse"/>
  </message>

  <!-- Port Type -->
  <portType name="SalesforceLeadCreatePortType">
    <operation name="create">
      <input message="tns:CreateLeadRequestMessage"/>
      <output message="tns:CreateLeadResponseMessage"/>
    </operation>
  </portType>

  <!-- Binding -->
  <binding name="SalesforceLeadCreateBinding" type="tns:SalesforceLeadCreatePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="create">
      <soap:operation soapAction="urn:create"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>

  <!-- Service -->
  <service name="SalesforceLeadCreateService">
    <port name="SalesforceLeadCreatePort" binding="tns:SalesforceLeadCreateBinding">
      <soap:address location="https://firstdata--prodcopy.sandbox.my.salesforce.com/services/Soap/u/58.0"/>
    </port>
  </service>

</definitions>
